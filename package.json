{
  "name": "@turbowarp/scratch-storage",
  "version": "2.1.0",
  "description": "Load and store project and asset files for Scratch 3.0",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/TurboWarp/scratch-storage#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/TurboWarp/scratch-storage.git"
  },
  "main": "./dist/node/scratch-storage.js",
  "browser": "./dist/web/scratch-storage.js",
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "webpack --progress --colors --bail",
    "test": "npm run test:lint && npm run test:unit && npm run test:integration",
    "test:lint": "eslint .",
    "test:integration": "node --require ./test/setup.js --test \"test/integration/*.test.js\"",
    "test:unit": "node --require ./test/setup.js --test \"test/unit/*.test.js\"",
    "watch": "webpack --progress --colors --watch"
  },
  "dependencies": {
    "@babel/runtime": "7.21.0",
    "@turbowarp/nanolog": "^0.2.0",
    "arraybuffer-loader": "^1.0.3",
    "base64-js": "1.3.0",
    "cross-fetch": "3.1.5",
    "worker-loader": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "7.14.8",
    "@babel/plugin-transform-runtime": "7.21.0",
    "@babel/polyfill": "7.12.1",
    "@babel/preset-env": "7.14.8",
    "babel-eslint": "10.1.0",
    "babel-loader": "8.0.6",
    "eslint": "8.55.0",
    "eslint-config-scratch": "9.0.3",
    "eslint-plugin-react": "7.33.2",
    "file-loader": "4.1.0",
    "json": "^9.0.4",
    "webpack": "4.47.0",
    "webpack-cli": "3.1.2"
  },
  "overrides": {
    "webpack@4.47.0": {
      "terser-webpack-plugin": "^4.2.3"
    }
  }
}
